static func exists(id: String) -> bool:
	return ALL.has(id)


static var _textures := {}


## The trinket's icon, trimmed to the drawn item (the source tiles leave a
## lot of empty space around small items like rings) and kept square.
static func texture(id: String) -> Texture2D:
	if _textures.has(id):
		return _textures[id]
	var tex: Texture2D = load("res://assets/sprites/items/%s.png" % id)
	var out: Texture2D = tex
	var img := tex.get_image() if tex else null
	if img:
		if img.is_compressed():
			img.decompress()
		var used := img.get_used_rect()
		if used.size.x > 0 and used.size.y > 0:
			var side := maxi(used.size.x, used.size.y) + 2
			var square := Image.create(side, side, false, Image.FORMAT_RGBA8)
			img.convert(Image.FORMAT_RGBA8)
			square.blit_rect(img, used, Vector2i((side - used.size.x) / 2, (side - used.size.y) / 2))
			out = ImageTexture.create_from_image(square)
	_textures[id] = out
	return out


static func rarity_of(id: String) -> String:
	return str(ALL[id]["rarity"]) if ALL.has(id) else "common"


static func ids_by_rarity(rarity: String) -> Array:
	var out: Array = []
	for id in ALL:
		if ALL[id]["rarity"] == rarity:
			out.append(id)
	return out


## Up to SLOTS valid, distinct trinket ids from untrusted input.
static func clean_list(list) -> Array:
	var out: Array = []
	if typeof(list) != TYPE_ARRAY:
		return out
	for t in list:
		var id := str(t)
		if ALL.has(id) and not out.has(id):
			out.append(id)
		if out.size() >= SLOTS:
			break
	return out


## Battle modifiers for a set of trinkets: multipliers multiply, bonuses add,
## and type changes come from the later trinket.
static func mods_for(ids: Array) -> Dictionary:
	var mods := {}
	for t in ids:
		if not ALL.has(t):
			continue
		var tm: Dictionary = ALL[t]["mods"]
		for k in tm:
			if k == "count_mult":
				continue
			if k.ends_with("_mult"):
				mods[k] = float(mods.get(k, 1.0)) * float(tm[k])
			elif k in ["armor", "damage", "flying"]:
				mods[k] = tm[k]
			else:
				mods[k] = float(mods.get(k, 0.0)) + float(tm[k])
	return mods


static func count_mult(ids: Array) -> float:
	var m := 1.0
	for t in ids:
		if ALL.has(t):
			m *= float(ALL[t]["mods"].get("count_mult", 1.0))
	return m


## Roll the three trinkets offered by a hunt at `site_id`. Trinkets the
## player doesn't own are preferred; owned ones only come up when a rarity is
## complete (and then pay gold instead).
## A site's rarity weights after the server's trinket drop multipliers.
static func site_weights(site_id: String) -> Dictionary:
	var out := {}
	for r in RARITY_ORDER:
		out[r] = DropRates.trinket_weight(r, float(SITES[site_id]["weights"].get(r, 0)))
	return out


static func roll_hunt(site_id: String, owned: Dictionary, rng: RandomNumberGenerator) -> Array:
	var weights := site_weights(site_id)
	var out: Array = []
	for _i in 3:
		var rarity := _pick_rarity(weights, rng)
		var pool: Array = []
		for id in ids_by_rarity(rarity):
			if not owned.has(id) and not out.has(id):
				pool.append(id)
		if pool.is_empty():
			for id in ids_by_rarity(rarity):
				if not out.has(id):
					pool.append(id)
		if pool.is_empty():
			continue
		out.append(pool[rng.randi_range(0, pool.size() - 1)])
	return out


static func _pick_rarity(weights: Dictionary, rng: RandomNumberGenerator) -> String:
	var total := 0.0
	for r in RARITY_ORDER:
		total += float(weights.get(r, 0))
	if total <= 0.0:
		return "common"
	var roll := rng.randf() * total
	for r in RARITY_ORDER:
		roll -= float(weights.get(r, 0))
		if roll < 0.0:
			return r
	return RARITY_ORDER[RARITY_ORDER.size() - 1]


## Chance of each rarity per offered trinket at a site, e.g. {"rare": 0.06}.
static func site_odds(site_id: String) -> Dictionary:
	var weights := site_weights(site_id)
	var total := 0.0
	for r in RARITY_ORDER:
		total += float(weights.get(r, 0))
	var out := {}
	for r in RARITY_ORDER:
		out[r] = float(weights.get(r, 0)) / maxf(1.0, total)
	return out
